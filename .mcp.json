  "mcpServers": {
    "irix-indy53": {
      "type": "stdio",
      "command": "powershell",
      "args": [
        "-NonInteractive", "-File",
        "c:/dev/projects/mcpserver-irix/scripts/tcp-bridge.ps1",
        "-RemoteHost", "localhost", "-Port", "8753"
      ]
    },
    "irix-octane2": {
      "type": "stdio",
